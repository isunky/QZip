<Configuration>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\AICode\QZip</HostFolder>
      <SandboxFolder>C:\QZip</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>D:\AICode\QZip\artifacts\acceptance\windows-sandbox</HostFolder>
      <SandboxFolder>C:\QZipResults</SandboxFolder>
      <ReadOnly>false</ReadOnly>
