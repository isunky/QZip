{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QZip",
  "version": "1.0.0",
  "identifier": "app.qzip.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QZip",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installerHooks": "./windows/qzip-shell-hooks.nsh" }
    },
    "fileAssociations": [
      { "ext": ["7z"], "name": "7-Zip Archive", "role": "Viewer", "rank": "Alternate" },
      { "ext": ["zip"], "name": "ZIP Archive", "role": "Viewer", "rank": "Alternate" },
      { "ext": ["rar"], "name": "RAR Archive", "role": "Viewer", "rank": "Alternate" },
      { "ext": ["tar", "gz", "xz", "bz2"], "name": "Compressed Archive", "role": "Viewer", "rank": "Alternate" }
    ]
  }
}
