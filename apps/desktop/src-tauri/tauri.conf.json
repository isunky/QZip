{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QZip",
  "version": "1.1.2",
  "identifier": "app.qzip.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:web",
    "beforeBuildCommand": "corepack pnpm build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QZip",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/qzip-shell-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English", "SimpChinese"]
      }
    }
  }
}
