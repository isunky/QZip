{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QZip",
  "version": "0.1.0",
  "identifier": "app.qzip.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QZip",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
